{
  "device": "metal",
  "tokenizer": {
    "family": "hf-tokenizer-json",
    "path": "apps/decoder-lm/data/wikitext-gpt2-tokenizer.json",
    "specialTokens": {
      "eos": "<|endoftext|>"
    }
  },
  "corpus": {
    "paths": [
      "apps/decoder-lm/data/wikitext-2-train.txt"
    ],
    "validationPaths": [
      "apps/decoder-lm/data/wikitext-2-validation.txt"
    ],
    "tokenCachePath": "apps/decoder-lm/artifacts/wikitext-8layer/train-clean-cache.json",
    "tokenCacheKey": "wikitext-2-gpt2-clean-v1",
    "validationTokenCachePath": "apps/decoder-lm/artifacts/wikitext-8layer/validation-clean-cache.json",
    "validationTokenCacheKey": "wikitext-2-gpt2-clean-v1",
    "preprocess": {
      "replacements": [
        { "from": " @-@ ", "to": "-" },
        { "from": " @,@ ", "to": "," },
        { "from": "<unk>", "to": "" }
      ],
      "normalizeWhitespace": true
    },
    "addBos": false,
    "addEos": true,
    "seqLen": 256,
    "stride": 128,
    "shuffle": true
  },
  "model": {
    "dModel": 256,
    "numLayers": 8,
    "numHeads": 8,
    "hiddenDim": 1024,
    "dropout": 0.1,
    "causal": true,
    "positional": "learned",
    "maxSeqLen": 256,
    "tieEmbeddings": true
  },
  "training": {
    "epochs": 2,
    "batchSize": 4,
    "compileModelForward": true,
    "validationBatchSize": 8,
    "lrSchedule": {
      "kind": "warmup_cosine",
      "start": 0.000001,
      "peak": 0.00001,
      "end": 0.000002,
      "warmup": {
        "unit": "step",
        "value": 125
      },
      "total": {
        "unit": "step",
        "value": 9472
      }
    },
    "maxGradNorm": 1.0,
    "shuffleSeed": 123
  },
  "checkpoint": {
    "prefix": "apps/decoder-lm/artifacts/wikitext-8layer/clean-run",
    "resumeStrategy": "exact",
    "restoreOptimizerState": true,
    "everyNEpochs": 1,
    "everyNSteps": 0,
    "metadata": {
      "dataset": "WikiText-2",
      "variant": "8layer"
    }
  },
  "report": {
    "summaryPath": "apps/decoder-lm/artifacts/wikitext-8layer/clean-run-summary.json",
    "progress": {
      "trainPhase": false,
      "trainLossEveryBatches": 5,
      "runtimeStatsEveryBatches": 25,
      "evalEveryBatches": 10,
      "epochSummary": true
    },
    "monitor": {
      "everyBatches": 25,
      "maxSamples": 1024,
      "path": "apps/decoder-lm/artifacts/wikitext-8layer/clean-run-monitor.json"
    },
    "sample": {
      "prompt": "The history of",
      "max_new_tokens": 48,
      "everyNEpochs": 1,
      "temperature": 0.7,
      "top_k": 20,
      "addBos": false,
      "skipSpecialTokens": true,
      "banSpecialTokens": true
    }
  }
}
