{
  "device": "cpu",
  "tokenizer": {
    "family": "hf-tokenizer-json",
    "path": "apps/decoder-lm/data/helloworld-tokenizer.json",
    "specialTokens": {
      "bos": "<bos>",
      "eos": "<eos>",
      "unk": "<unk>"
    }
  },
  "corpus": {
    "path": "apps/decoder-lm/data/helloworld-train.txt",
    "tokenCachePath": "apps/decoder-lm/artifacts/helloworld/train-cache.json",
    "validationTokenCachePath": "apps/decoder-lm/artifacts/helloworld/validation-cache.json",
    "addBos": true,
    "addEos": true,
    "seqLen": 3,
    "stride": 1,
    "validationSplit": 0.2,
    "shuffle": false
  },
  "model": {
    "dModel": 32,
    "numLayers": 1,
    "numHeads": 4,
    "hiddenDim": 64,
    "causal": true,
    "positional": "learned",
    "maxSeqLen": 8,
    "tieEmbeddings": true
  },
  "training": {
    "epochs": 20,
    "batchSize": 2,
    "lr": 0.01
  },
  "checkpoint": {
    "prefix": "apps/decoder-lm/artifacts/helloworld/run",
    "everyNEpochs": 10,
    "metadata": {
      "example": "helloworld-corpus"
    }
  },
  "report": {
    "progress": {
      "trainPhase": true,
      "trainLossEveryBatches": 1,
      "evalEveryBatches": 1,
      "epochSummary": true
    },
    "sample": {
      "prompt": "hello",
      "max_new_tokens": 1,
      "everyNEpochs": 10,
      "addBos": true,
      "skipSpecialTokens": true,
      "banSpecialTokens": true
    }
  }
}
