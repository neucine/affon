+
+// Each block owns one dense suffix. Accumulate in double and compute centered
+// variance to avoid cancellation for rows with a large common offset.
+extern "C" __global__ void compute_normalize_dense_f32_parallel(
+    float *input_output, uint64_t groups, uint64_t suffix,
+    float epsilon, uint32_t rms_only
+) {
+    uint64_t group = blockIdx.x;
+    if (group >= groups) return;
+    uint32_t lane = threadIdx.x;
+    float *row = input_output + group * suffix;
+    __shared__ double partials[256];
+    double sum = 0;
+    for (uint64_t index = lane; index < suffix; index += blockDim.x) {
+        double value = (double)row[index];
+        sum += rms_only ? value * value : value;
+    }
+    partials[lane] = sum;
+    __syncthreads();
+    for (uint32_t span = blockDim.x / 2; span; span >>= 1) {
+        if (lane < span) partials[lane] += partials[lane + span];
+        __syncthreads();
+    }
+    double mean = rms_only ? 0.0 : partials[0] / (double)suffix;
+    double variance = partials[0] / (double)suffix;
+    __syncthreads();
+    if (!rms_only) {
+        double squares = 0;
+        for (uint64_t index = lane; index < suffix; index += blockDim.x) {
+            double centered = (double)row[index] - mean;
+            squares += centered * centered;
+        }
+        partials[lane] = squares;
+        __syncthreads();
+        for (uint32_t span = blockDim.x / 2; span; span >>= 1) {
+            if (lane < span) partials[lane] += partials[lane + span];
+            __syncthreads();
+        }
+        variance = partials[0] / (double)suffix;
+    }
+    double denominator = sqrt(variance + (double)epsilon);
+    for (uint64_t index = lane; index < suffix; index += blockDim.x)
+        row[index] = (float)(((double)row[index] - mean) / denominator);
+}
+
+struct QuantizedMatmulParams {
+    uint64_t shape[4]; // M, N, K, group size
+    int64_t strides[8];
+    uint64_t offsets[4]; // byte offsets
+    uint32_t bits, input_bf16, parameter_bf16;
+};
+
+extern "C" __global__ void compute_quantized_matmul(
+    const char *x_bytes, const char *w_bytes, const char *s_bytes,
+    const char *b_bytes, float *output, QuantizedMatmulParams params
+) {
+    uint64_t linear = (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    uint64_t rows = params.shape[0], columns = params.shape[1], inner = params.shape[2];
+    if (linear >= rows * columns) return;
+    uint64_t row = linear / columns, column = linear % columns;
+    const char *x = x_bytes + params.offsets[0];
+    const uint32_t *words = (const uint32_t *)(w_bytes + params.offsets[1]);
+    const char *scales = s_bytes + params.offsets[2];
+    const char *biases = b_bytes + params.offsets[3];
+    uint32_t per_word = 32 / params.bits, mask = (1u << params.bits) - 1;
+    float sum = 0;
+    for (uint64_t k = 0; k < inner; ++k) {
+        int64_t xi = row * params.strides[0] + k * params.strides[1];
+        int64_t wi = column * params.strides[2] + (k / per_word) * params.strides[3];
+        int64_t si = column * params.strides[4] + (k / params.shape[3]) * params.strides[5];
+        int64_t bi = column * params.strides[6] + (k / params.shape[3]) * params.strides[7];
+        float value = params.input_bf16 ? __uint_as_float((uint32_t)((const uint16_t *)x)[xi] << 16) : ((const float *)x)[xi];
+        float scale = params.parameter_bf16 ? __uint_as_float((uint32_t)((const uint16_t *)scales)[si] << 16) : ((const float *)scales)[si];
+        float bias = params.parameter_bf16 ? __uint_as_float((uint32_t)((const uint16_t *)biases)[bi] << 16) : ((const float *)biases)[bi];
+        float q = (float)((words[wi] >> ((k % per_word) * params.bits)) & mask);
+        sum += value * (scale * q + bias);
+    }
+    output[linear] = sum;
+}
+
+struct DenseLossWarpParams {
+    uint64_t rows, classes, logits_offset, targets_offset;
+    int64_t logit_row_stride, logit_column_stride, target_row_stride, target_column_stride;
+    uint32_t bf16;
+};
+
+__device__ static double dense_loss_value(const void *values, int64_t index, uint32_t bf16) {
+    return bf16 ? (double)__uint_as_float((uint32_t)((const uint16_t *)values)[index] << 16)
+                : (double)((const float *)values)[index];
+}
+
+// Independent warps process rows without a block-wide barrier for every row.
+// Only the final mean needs communication between warps; no scratch allocation.
+extern "C" __global__ void compute_dense_loss_warp(
+    const void *logits, const void *targets, void *output, DenseLossWarpParams params
+) {
+    uint32_t lane = threadIdx.x & 31u, warp = threadIdx.x >> 5;
+    uint32_t warps = blockDim.x >> 5;
+    double loss = 0;
+    for (uint64_t row = warp; row < params.rows; row += warps) {
+        int64_t logit_base = (int64_t)params.logits_offset + (int64_t)row * params.logit_row_stride;
+        int64_t target_base = (int64_t)params.targets_offset + (int64_t)row * params.target_row_stride;
+        double maximum = -INFINITY;
+        for (uint64_t column = lane; column < params.classes; column += 32)
+            maximum = fmax(maximum, dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16));
+        for (uint32_t span = 16; span; span >>= 1)
+            maximum = fmax(maximum, __shfl_down_sync(0xffffffffu, maximum, span));
+        maximum = __shfl_sync(0xffffffffu, maximum, 0);
+        double denominator = 0;
+        for (uint64_t column = lane; column < params.classes; column += 32)
+            denominator += exp(dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16) - maximum);
+        for (uint32_t span = 16; span; span >>= 1)
+            denominator += __shfl_down_sync(0xffffffffu, denominator, span);
+        double log_denominator = log(__shfl_sync(0xffffffffu, denominator, 0));
+        double row_loss = 0;
+        for (uint64_t column = lane; column < params.classes; column += 32) {
+            double value = dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16);
+            double target = dense_loss_value(targets, target_base + (int64_t)column * params.target_column_stride, params.bf16);
+            row_loss -= target * (value - maximum - log_denominator);
+        }
+        for (uint32_t span = 16; span; span >>= 1)
+            row_loss += __shfl_down_sync(0xffffffffu, row_loss, span);
+        if (!lane) loss += row_loss;
+    }
+    __shared__ double losses[8];
+    if (!lane) losses[warp] = loss;
+    __syncthreads();
+    if (!threadIdx.x) {
+        double total = 0;
+        for (uint32_t index = 0; index < warps; ++index) total += losses[index];
+        float result = (float)(total / (double)params.rows);
+        if (params.bf16) ((uint16_t *)output)[0] = encode_bf16(result);
+        else ((float *)output)[0] = result;
+    }
+}
+
+// When there are fewer independent rows than warps, share the block between
+// power-of-two row teams so long rows can use more than a single warp.
+extern "C" __global__ void compute_dense_loss_cooperative(
+    const void *logits, const void *targets, void *output, DenseLossWarpParams params
+) {
+    uint32_t teams = 1;
+    while (teams < 8 && teams * 2 <= params.rows) teams *= 2;
+    uint32_t width = blockDim.x / teams;
+    uint32_t team = threadIdx.x / width, lane = threadIdx.x % width;
+    __shared__ double partials[256], losses[8];
+    double loss = 0;
+    for (uint64_t base = 0; base < params.rows; base += teams) {
+        uint64_t row = base + team;
+        bool active = row < params.rows;
+        int64_t logit_base = (int64_t)params.logits_offset + (int64_t)row * params.logit_row_stride;
+        int64_t target_base = (int64_t)params.targets_offset + (int64_t)row * params.target_row_stride;
+        double maximum = -INFINITY;
+        if (active) for (uint64_t column = lane; column < params.classes; column += width)
+            maximum = fmax(maximum, dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16));
+        partials[threadIdx.x] = maximum;
+        __syncthreads();
+        for (uint32_t span = width / 2; span; span >>= 1) {
+            if (lane < span) partials[threadIdx.x] = fmax(partials[threadIdx.x], partials[threadIdx.x + span]);
+            __syncthreads();
+        }
+        maximum = partials[team * width];
+        __syncthreads();
+        double denominator = 0;
+        if (active) for (uint64_t column = lane; column < params.classes; column += width)
+            denominator += exp(dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16) - maximum);
+        partials[threadIdx.x] = denominator;
+        __syncthreads();
+        for (uint32_t span = width / 2; span; span >>= 1) {
+            if (lane < span) partials[threadIdx.x] += partials[threadIdx.x + span];
+            __syncthreads();
+        }
+        double log_denominator = active ? log(partials[team * width]) : 0;
+        __syncthreads();
+        double row_loss = 0;
+        if (active) for (uint64_t column = lane; column < params.classes; column += width) {
+            double value = dense_loss_value(logits, logit_base + (int64_t)column * params.logit_column_stride, params.bf16);
+            double target = dense_loss_value(targets, target_base + (int64_t)column * params.target_column_stride, params.bf16);
+            row_loss -= target * (value - maximum - log_denominator);
+        }
+        partials[threadIdx.x] = row_loss;
+        __syncthreads();
+        for (uint32_t span = width / 2; span; span >>= 1) {
+            if (lane < span) partials[threadIdx.x] += partials[threadIdx.x + span];
+            __syncthreads();
+        }
+        if (!lane) loss += partials[team * width];
+        __syncthreads();
+    }
+    if (!lane) losses[team] = loss;
+    __syncthreads();
+    if (!threadIdx.x) {
+        double total = 0;
+        for (uint32_t index = 0; index < teams; ++index) total += losses[index];
+        float result = (float)(total / (double)params.rows);
+        if (params.bf16) ((uint16_t *)output)[0] = encode_bf16(result);
+        else ((float *)output)[0] = result;
+    }
+}
