  "cells": [
    {
      "id": "cell-1",
      "kind": "markdown",
      "language": "markdown",
      "source": "# Tensor Elementwise\n\nElementwise arithmetic, unary math, and activation ops.",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-2",
      "kind": "code",
      "language": "typescript",
      "source": "import { tensor, add, sub, mul, div, exp, log, sqrt, abs, neg, clamp, relu, gelu, sigmoid, tanh, sum, mean, variance, std, argmax, reshape, transpose, permute, squeeze, unsqueeze, cat, stack, contiguous, where, masked_fill, softmax, one_hot, gather, topk } from 'affon:compute'\n\n\n\nfunction printValue(label: string, value: { toString(): string }) {\n  console.log(label)\n  console.log(value)\n}\n\nfunction printBeforeAfter(beforeLabel: string, beforeValue: { toString(): string }, afterLabel: string, afterValue: { toString(): string }) {\n  printValue(beforeLabel, beforeValue)\n  printValue(afterLabel, afterValue)\n}\n",
      "outputs": [],
      "execution_count": 31,
      "metadata": {}
    },
    {
      "id": "cell-3",
      "kind": "markdown",
      "language": "markdown",
      "source": "## add\n\n$$\nz = x + y\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-4",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])\nconst y = tensor([[[10, 20], [30, 40]], [[50, 60], [70, 80]]])\nprintBeforeAfter('before x', x, 'after add(x, y)', add(x, y))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n\nafter add(x, y)\n[2×2×2 Tensor, dtype=f32]\n[[[11, 22], [33, 44]], [[55, 66], [77, 88]]]\n\n"
            }
          ]
        }
      ],
      "execution_count": 32,
      "metadata": {}
    },
    {
      "id": "cell-5",
      "kind": "markdown",
      "language": "markdown",
      "source": "## sub\n\n$$\nz = x - y\n$$\n",
