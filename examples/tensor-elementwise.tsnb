              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[10, 20], [30, 40]], [[50, 60], [70, 80]]]\n\nafter sub(x, y)\n[2×2×2 Tensor, dtype=f32]\n[[[9, 18], [27, 36]], [[45, 54], [63, 72]]]\n\n"
            }
