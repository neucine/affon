{
  "format": 1,
  "metadata": {
    "kernelspec": {
      "name": "affon",
      "display_name": "Affon (TypeScript)",
      "language": "typescript"
    }
  },
  "cells": [
    {
      "id": "cell-1",
      "kind": "markdown",
      "language": "markdown",
      "source": "# Tensor Reduction\n\nReduction and normalization examples on 3D tensors.",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-2",
      "kind": "code",
      "language": "typescript",
      "source": "import { tensor, add, sub, mul, div, exp, log, sqrt, abs, neg, clamp, relu, gelu, sigmoid, tanh, sum, mean, variance, std, argmax, reshape, transpose, permute, squeeze, unsqueeze, cat, stack, contiguous, where, masked_fill, softmax, one_hot, gather, topk } from 'affon:compute'\n\n\n\nfunction printValue(label: string, value: { toString(): string }) {\n  console.log(label)\n  console.log(value)\n}\n\nfunction printBeforeAfter(beforeLabel: string, beforeValue: { toString(): string }, afterLabel: string, afterValue: { toString(): string }) {\n  printValue(beforeLabel, beforeValue)\n  printValue(afterLabel, afterValue)\n}\n",
      "outputs": [],
      "execution_count": 1,
      "metadata": {}
    },
    {
      "id": "cell-3",
      "kind": "markdown",
      "language": "markdown",
      "source": "## sum\n\n$$\n\\sum x\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-4",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])\nprintBeforeAfter('before x', x, 'after sum(x, axis=2)', sum(x, 2))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n\nafter sum(x, axis=2)\n[2×2 Tensor, dtype=f32]\n      0   1\n  ┌          ┐\n0 │   3   7  │\n1 │  11  15  │\n  └          ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 2,
      "metadata": {}
    },
    {
      "id": "cell-5",
      "kind": "markdown",
      "language": "markdown",
      "source": "## mean\n\n$$\n\\mathrm{mean}(x)\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-6",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])\nprintBeforeAfter('before x', x, 'after mean(x, axis=1)', mean(x, 1))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n\nafter mean(x, axis=1)\n[2×2 Tensor, dtype=f32]\n     0  1\n  ┌        ┐\n0 │  2  3  │\n1 │  6  7  │\n  └        ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 3,
      "metadata": {}
    },
    {
      "id": "cell-7",
      "kind": "markdown",
      "language": "markdown",
      "source": "## variance\n\n$$\n\\mathrm{Var}(x) = \\mathrm{mean}((x - \\mathrm{mean}(x))^2)\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-8",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])\nprintBeforeAfter('before x', x, 'after variance(x, axis=2)', variance(x, 2))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n\nafter variance(x, axis=2)\n[2×2 Tensor, dtype=f32]\n        0     1\n  ┌              ┐\n0 │  0.25  0.25  │\n1 │  0.25  0.25  │\n  └              ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 4,
      "metadata": {}
    },
    {
      "id": "cell-9",
      "kind": "markdown",
      "language": "markdown",
      "source": "## std\n\n$$\n\\mathrm{std}(x) = \\sqrt{\\mathrm{Var}(x)}\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-10",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])\nprintBeforeAfter('before x', x, 'after std(x, axis=2)', std(x, 2))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\n\nafter std(x, axis=2)\n[2×2 Tensor, dtype=f32]\n       0    1\n  ┌            ┐\n0 │  0.5  0.5  │\n1 │  0.5  0.5  │\n  └            ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 5,
      "metadata": {}
    },
    {
      "id": "cell-11",
      "kind": "markdown",
      "language": "markdown",
      "source": "## argmax\n\nReturn the index of the maximum value along an axis.",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-12",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[[3, 2], [8, 1]], [[5, 9], [7, 4]]])\nprintBeforeAfter('before x', x, 'after argmax(x, axis=2)', argmax(x, 2))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before x\n[2×2×2 Tensor, dtype=f32]\n[[[3, 2], [8, 1]], [[5, 9], [7, 4]]]\n\nafter argmax(x, axis=2)\n[2×2 Tensor, dtype=i64]\n     0  1\n  ┌        ┐\n0 │  0  0  │\n1 │  1  0  │\n  └        ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 6,
      "metadata": {}
    },
    {
      "id": "cell-13",
      "kind": "markdown",
      "language": "markdown",
      "source": "## softmax\n\n$$\n\\mathrm{softmax}(x_i) = \\frac{e^{x_i}}{\\sum_j e^{x_j}}\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-14",
      "kind": "code",
      "language": "typescript",
      "source": "const logits = tensor([[[1, 2, 3], [2, 1, 0]], [[0, 1, 2], [3, 2, 1]]])\nprintBeforeAfter('before logits', logits, 'after softmax(logits, 2)', softmax(logits, 2))\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before logits\n[2×2×3 Tensor, dtype=f32]\n[[[1, 2, 3], [2, 1, 0]], [[0, 1, 2], [3, 2, 1]]]\n\nafter softmax(logits, 2)\n[2×2×3 Tensor, dtype=f32]\n[[[0.090031, 0.244728, 0.665241], [0.665241, 0.244728, 0.090031]], [[0.090031, 0.244728, 0.665241], [0.665241, 0.244728, 0.090031]]]\n\n"
            }
          ]
        }
      ],
      "execution_count": 7,
      "metadata": {}
    }
  ]
}
