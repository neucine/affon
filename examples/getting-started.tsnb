{
  "format": 1,
  "metadata": {
    "kernelspec": {
      "name": "affon",
      "display_name": "Affon (TypeScript)",
      "language": "typescript"
    }
  },
  "cells": [
    {
      "id": "cell-1",
      "kind": "markdown",
      "language": "markdown",
      "source": "# Getting Started with Affon\n\nThis notebook demonstrates Affon's compute-first core features: tensors, gradients, neural networks, schedules, and plotting.\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-2",
      "kind": "code",
      "language": "typescript",
      "source": "import {\n  Duration,\n  schedules,\n  scheduled,\n  tensor,\n  parameter,\n  module,\n  add,\n  matmul,\n  randn,\n  mul,\n  sum,\n  sigmoid,\n  clear_grad,\n  grad,\n  sgd,\n} from 'affon:compute'\nimport type { Tensor } from 'affon:compute'\nimport nn from 'affon:nn'\nimport { figure, title, xlabel, ylabel, plot, scatter, show } from 'affon:plot'\n",
      "outputs": [],
      "execution_count": 1,
      "metadata": {}
    },
    {
      "id": "cell-3",
      "kind": "markdown",
      "language": "markdown",
      "source": "## 1. Compute Tensors\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-4",
      "kind": "code",
      "language": "typescript",
      "source": "const a = tensor([[1, 2, 3], [4, 5, 6]])\nconsole.log('shape:', a.shape)\nconsole.log('dtype:', a.dtype)\nconsole.log(a)\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "shape: [ 2, 3 ]\ndtype: f32\n[2×3 Tensor, dtype=f32]\n     0  1  2\n  ┌           ┐\n0 │  1  2  3  │\n1 │  4  5  6  │\n  └           ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 2,
      "metadata": {}
    },
    {
      "id": "cell-5",
      "kind": "code",
      "language": "typescript",
      "source": "const x = tensor([[1, 2], [3, 4]])\nconst y = tensor([[10, 20], [30, 40]])\nconsole.log('add:', add(x, y).to_array())\nconsole.log('matmul:', matmul(x, y).to_array())\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "add: [ [ 11, 22 ], [ 33, 44 ] ]\nmatmul: [ [ 70, 100 ], [ 150, 220 ] ]\n"
            }
          ]
        }
      ],
      "execution_count": 3,
      "metadata": {}
    },
    {
      "id": "cell-6",
      "kind": "markdown",
      "language": "markdown",
      "source": "## 2. Autograd",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-7",
      "kind": "code",
      "language": "typescript",
      "source": "const a = parameter([2]).randn()\nconst b = tensor([4, 5])\nconst c = sum(mul(a, b))\nconsole.log('c =', c)\n\ngrad(c, [a])\nconsole.log('dc/da =', a.grad)\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "c = [1 Tensor, dtype=f32]\n  0         \n[ 1.025905  ]\n\ndc/da = [2 Tensor, dtype=f32]\n  0  1  \n[ 4  5  ]\n\n"
            }
          ]
        }
      ],
      "execution_count": 4,
      "metadata": {}
    },
    {
      "id": "cell-8",
      "kind": "markdown",
      "language": "markdown",
      "source": "## 3. Neural Network: Linear Regression",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-9",
      "kind": "code",
      "language": "typescript",
      "source": "// y = 2x + 1\nconst X = tensor([[1], [2], [3], [4], [5]])\nconst Y = tensor([[3], [5], [7], [9], [11]])\n\nconst W = parameter([1, 1]).randn()\nconst b = parameter([1, 1]).randn()\nconst params = [W, b]\nconst step = sgd({ lr: 0.01 })\nconst criterion = nn.MSELoss()\n\nfor (let i = 0; i < 200; i++) {\n  clear_grad(params)\n  const pred = add(matmul(X, W), b)\n  const loss = criterion(pred, Y)\n  grad(loss, params)\n  step(params)\n  if (i % 50 === 0) console.log(`epoch ${i}: loss =`, loss)\n}\n\nconsole.log('W:', W, 'b:', b)\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "epoch 0: loss = [1 Tensor, dtype=f32]\n  0          \n[ 15.016531  ]\n\nepoch 50: loss = [1 Tensor, dtype=f32]\n  0         \n[ 0.275305  ]\n\nepoch 100: loss = [1 Tensor, dtype=f32]\n  0         \n[ 0.196215  ]\n\nepoch 150: loss = [1 Tensor, dtype=f32]\n  0         \n[ 0.139846  ]\n\nW: [1×1 Tensor, dtype=f32]\n            0\n  ┌            ┐\n0 │  2.204966  │\n  └            ┘\n b: [1×1 Tensor, dtype=f32]\n            0\n  ┌            ┐\n0 │  0.260008  │\n  └            ┘\n\n"
            }
          ]
        }
      ],
      "execution_count": 5,
      "metadata": {}
    },
    {
      "id": "cell-10",
      "kind": "markdown",
      "language": "markdown",
      "source": "## 4. Plotting",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "cell-11",
      "kind": "code",
      "language": "typescript",
      "source": "\nfigure({ width: 600, height: 400 })\ntitle('y = sin(x)')\nxlabel('x')\nylabel('y')\n\nconst xs: number[] = []\nconst ys: number[] = []\nfor (let i = 0; i <= 100; i++) {\n  const x = (i / 100) * 4 * Math.PI\n  xs.push(x)\n  ys.push(Math.sin(x))\n}\nplot(xs, ys, { label: 'sin(x)', color: '#1f77b4' })\nshow()",
      "outputs": [
        {
          "items": [
            {
              "mime": "image/svg+xml",
