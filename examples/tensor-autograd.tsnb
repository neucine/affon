  },
  "cells": [
    {
      "id": "cell-1",
      "kind": "markdown",
      "language": "markdown",
      "source": "# Tensor Gradients\n\nSmall parameter-gradient examples for `affon:compute`.\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "84f18f94",
      "kind": "code",
      "language": "typescript",
      "source": "import { parameter, add, matmul, sum, mean, grad } from 'affon:compute'\n",
      "outputs": [],
      "execution_count": 1,
      "metadata": {}
    },
    {
      "id": "af36840d",
      "kind": "markdown",
      "language": "markdown",
      "source": "## Add Backward\n\n$$\nz = x + y,\n\\quad L = \\sum z\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "460be078",
      "kind": "code",
      "language": "typescript",
      "source": "const x = parameter([2, 2, 2]).randn()\nconst y = parameter([2, 2, 2]).randn()\nconst z = add(x, y)\nconst loss = sum(z)\nconsole.log('before loss')\nconsole.log(loss)\n\ngrad(loss, [x, y])\nconsole.log('dx =', x.grad)\nconsole.log('dy =', y.grad)\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before loss\n[1 Tensor, dtype=f32]\n  0          \n[ -1.160095  ]\n\ndx = [2×2×2 Tensor, dtype=f32]\n[[[1, 1], [1, 1]], [[1, 1], [1, 1]]]\n\ndy = [2×2×2 Tensor, dtype=f32]\n[[[1, 1], [1, 1]], [[1, 1], [1, 1]]]\n\n"
            }
          ]
        }
      ],
      "execution_count": 2,
      "metadata": {}
    },
    {
      "id": "5cc8c6a3",
      "kind": "markdown",
      "language": "markdown",
      "source": "## Matmul Backward\n\n$$\nY = XW,\n\\quad L = \\mathrm{mean}(Y)\n$$\n",
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "id": "ebdb71d1",
      "kind": "code",
      "language": "typescript",
      "source": "const x = parameter([2, 2, 3]).randn()\nconst w = parameter([2, 3, 2]).randn()\nconst y = matmul(x, w)\nconst loss = mean(y)\nconsole.log('before loss')\nconsole.log(loss)\n\ngrad(loss, [x, w])\nconsole.log('dx =', x.grad)\nconsole.log('dw =', w.grad)\n",
      "outputs": [
        {
          "items": [
            {
              "mime": "application/vnd.tsnb.stream.stdout",
              "value": "before loss\n[1 Tensor, dtype=f32]\n  0          \n[ -0.742562  ]\n\ndx = [2×2×3 Tensor, dtype=f32]\n[[[0.07034, -0.384989, -0.089295], [0.07034, -0.384989, -0.089295]], [[0.003383, -0.129255, -0.179046], [0.003383, -0.129255, -0.179046]]]\n\ndw = [2×3×2 Tensor, dtype=f32]\n[[[-0.053596, -0.053596], [-0.042011, -0.042011], [0.253914, 0.253914]], [[0.18676, 0.18676], [0.17881, 0.17881], [0.335503, 0.335503]]]\n\n"
            }
          ]
        }
      ],
      "execution_count": 3,
      "metadata": {}
    }
  ]
}
