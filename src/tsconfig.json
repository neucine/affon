{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "noEmit": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "typeRoots": ["../packages/@types"],
    "types": ["affon"],
    "paths": {
      "affon:_internal/compute/program": ["./js/compute/program.ts"],
      "affon:dataset/*": ["./js/dataset/*"]
    }
  },
  "include": [
    "js/**/*.d.ts",
    "../packages/@types/affon/globals.d.ts",
    "js/compute/public.ts",
    "js/compute/program.ts",
    "js/compute/persistence.ts",
    "js/checkpoint/index.ts",
    "js/dataset/index.ts",
    "js/dataset/tabular.ts",
    "js/dataset/tokenizer.ts",
    "js/dataset/text_loader.ts",
    "js/dataset/text_io.ts",
    "js/dataset/text_utils.ts",
    "js/dataset/token_windows.ts",
    "js/dataset/text.ts",
  ]
}
