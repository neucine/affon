{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "paths": {
      "affon:compute/legacy": ["./js/compute/index.ts"]
    }
  },
  "include": [
    "js/**/*.d.ts",
    "../packages/@types/affon/globals.d.ts",
    "js/compute/index.ts",
    "js/compute/public.ts",
    "js/compute/program.ts",
    "js/compute/persistence.ts",
    "js/compute/compile.ts",
    "js/compute/graph.ts",
    "js/checkpoint/index.ts",
    "js/nn/index.ts",
    "js/dataset/index.ts",
    "js/dataset/tabular.ts",
    "js/dataset/tokenizer.ts",
    "js/dataset/text_loader.ts",
    "js/dataset/text_io.ts",
    "js/dataset/text_utils.ts",
    "js/dataset/token_windows.ts",
    "js/dataset/text.ts",
  ]
}
